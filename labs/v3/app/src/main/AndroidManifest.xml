<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- JARVIS V3 demonstration build (installable). Same single permission as V1: the microphone,
         requested at first use. No INTERNET. Separate package (fr.jarvis.v3): V1 stays installable side by side. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application android:name="fr.jarvis.v1.V1App" android:label="JARVIS V3"
        android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="fr.jarvis.v3.CockpitActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Visual prototype of the states (labelled EXEMPLE) and before/after bench; not reachable from outside. -->
        <activity android:name="fr.jarvis.v3.StateGalleryActivity" android:exported="false" />
    </application>
</manifest>
